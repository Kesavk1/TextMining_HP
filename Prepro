  coord_flip()+
  labs(title = "Most popular words in the first 3 movies",
       subtitle = "Top 15 (without stopwords)",
       x = "Word", y = "Number of sentences", 
       caption = "© Made by Michau96/Kaggle")+
  theme_minimal()+
  theme_michau

